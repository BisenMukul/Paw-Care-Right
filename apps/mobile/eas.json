{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.bombaypetcompany.app",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "EXPO_PUBLIC_TERMS_URL": "https://bombaypetcompany.app/terms",
        "EXPO_PUBLIC_PRIVACY_URL": "https://bombaypetcompany.app/privacy"
      },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.bombaypetcompany.app",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "EXPO_PUBLIC_TERMS_URL": "https://bombaypetcompany.app/terms",
        "EXPO_PUBLIC_PRIVACY_URL": "https://bombaypetcompany.app/privacy"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "preview": { "android": { "track": "internal" } },
    "production": { "android": { "track": "internal" } }
  }
}
