{
  "name": "@pawcareright/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@pawcareright/analytics": "workspace:*",
    "@pawcareright/config": "workspace:*",
    "@pawcareright/data": "workspace:*",
    "@pawcareright/types": "workspace:*",
    "@sentry/nextjs": "^10.68.0",
    "next": "^15.5.22",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14",
    "@next/eslint-plugin-next": "^15",
    "@pawcareright/ai": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "^29.7.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ]
    },
    "testMatch": [
      "**/*.spec.ts",
      "**/*.spec.tsx"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
