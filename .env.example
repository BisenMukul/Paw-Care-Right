# Bombay Pet Company — example environment. Copy to .env and fill real values.
# .env is gitignored; this file is committed. List every key used across the repo here.

# --- AI providers (server-side only; never shipped in the client bundle). See docs/AI_PROVIDERS.md ---
GEMINI_API_KEY=example-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-example-image-model
OLLAMA_CLOUD_API_KEY=example-ollama-cloud-api-key
OLLAMA_CLOUD_BASE_URL=https://ollama.com
AI_TEXT_MODEL=example-text-model
AI_VISION_MODEL=example-vision-model
AI_TEXT_PROVIDER=ollama
AI_VISION_PROVIDER=ollama
AI_IMAGE_PROVIDER=gemini

# --- Local infrastructure (docker compose; dev-only fake creds) ---
POSTGRES_USER=bombaypetcompany
POSTGRES_PASSWORD=bombaypetcompany
POSTGRES_DB=bombaypetcompany
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=bombaypetcompany
MINIO_ROOT_PASSWORD=bombaypetcompany-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DATABASE_URL=postgresql://bombaypetcompany:bombaypetcompany@localhost:5432/bombaypetcompany?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth (apps/api; email OTP + JWT + refresh rotation) ---
JWT_SECRET=dev-insecure-jwt-secret-do-not-use-in-production
OTP_HMAC_SECRET=dev-insecure-otp-hmac-secret-do-not-use-in-production
APPLE_CLIENT_ID=com.bombaypetcompany.app
GOOGLE_CLIENT_ID=bombaypetcompany-dev.apps.googleusercontent.com

# --- API security baseline (apps/api; CORS) ---
WEB_ADMIN_ORIGIN=http://localhost:3001

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=bombaypetcompany
S3_SECRET_KEY=bombaypetcompany-dev-secret
S3_BUCKET=bombaypetcompany-media

# --- Remote config (apps/api; T074/T079). PAYWALL_VARIANT accepts A|B|AUTO
# (default AUTO: A/B force an override, AUTO hashes the caller's userId). ---
MIN_SUPPORTED_VERSION=0.0.0
HOTLINE_PACK_VERSION=1

# --- Analytics (PostHog; T078). Empty API keys are stub-safe no-ops. ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Observability (Sentry; T089). Empty DSNs are stub-safe no-ops -- the
# SDK is never initialized without one. GIT_SHA/APP_VERSION feed the pinned
# bombaypetcompany@{version}+{buildId} release shape (CLAUDE §1a). ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
GIT_SHA=dev
APP_VERSION=0.0.0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_GIT_SHA=dev
NEXT_PUBLIC_APP_VERSION=0.0.0
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_GIT_SHA=dev
